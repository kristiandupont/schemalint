{
  "name": "schemalint",
  "version": "2.3.2",
  "keywords": [
    "postgresql",
    "schema",
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:kristiandupont/schemalint.git"
  },
  "homepage": "https://github.com/kristiandupont/schemalint",
  "license": "MIT",
  "author": {
    "name": "Kristian Dupont",
    "url": "http://www.kristiandupont.com"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "schemalint": "./bin/schemalint"
  },
  "files": [
    "build/",
    "bin/"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "prettier --check .",
    "test": "vitest run",
    "version": "npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@kristiandupont/recase": "^1.4.2",
    "extract-pg-schema": "^5.8.3",
    "irregular-plurals": "^3.2.0",
    "pg": "^8.3.3"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/pg": "^8.11.0",
    "prettier": "^3.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.3.0"
  }
}
